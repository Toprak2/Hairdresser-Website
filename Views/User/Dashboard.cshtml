@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

@using System.Security.Claims
@model Hairdresser_Website.Models.DelApp

<style>
    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
    }

    .modal-content {
        background-color: white;
        margin: 10% auto;
        padding: 20px;
        border-radius: 10px;
        width: 40%;
        box-shadow: 0px 5px 15px rgba(0, 0, 0, 0.2);
    }

    .close-btn {
        float: right;
        font-size: 24px;
        font-weight: bold;
        cursor: pointer;
    }

    .yazi {
        margin: 0 0 15px;
        font-size: 24px;
        font-weight: bold;
        color: #6a0dad;
        margin-bottom: 16px;
    }
</style>

<div style="display: flex; flex-direction: column; justify-content: center; align-items: center; margin-top: 50px;">
    <h2 style="font-size: 36px; font-weight: bold; color: #6a0dad; text-align: center; margin-bottom: 20px;">Kullanıcı arayüzüne hoşgeldiniz</h2>
    <p style="font-size: 18px; color: #555; text-align: center; margin-bottom: 40px;">
        Sizinle tekrar bulaşabildiğimiz için çok mutluyuz. Buradan sipariş verebilir ve eski siparişlerinizi görebilir veya bir siparişinizi iptal edebilirsiniz.
    </p>

    <div style="display: flex; flex-direction: column; gap: 15px; align-items: center;">
        <!-- Sipariş Ver -->
        <a href="@Url.Action("Create", "Appointment")" class="btn" style="background-color: #6a0dad; color: white; padding: 17px; font-size: 16px; border: none; cursor: pointer; border-radius: 4px; width: 100%; transition: background-color 0.3s;">
            Sipariş Ver
        </a>

    <div style="margin-top: 20px; width: 100%; max-width: 400px;">
        <form id="listOrderForm" style="display: flex; flex-direction: column; align-items: center; gap: 20px;">
            <button type="button" id="listOrderBtn" class="btn" style="background-color: #6a0dad; color: white; padding: 17px; font-size: 16px; border: none; cursor: pointer; border-radius: 4px; width: 100%; transition: background-color 0.3s;">
                Eski Siparişleri Listele
            </button>
        </form>
    </div>

        <div id="customModal" class="modal">
            <div class="modal-content">
                <span class="close-btn">&times;</span>
                <h2 class="yazi">Eski Siparişler</h2>
                <ul id="appointmentList" style="border:medium;"></ul>
            </div>
        </div>

    <!-- Sipariş silme formu -->
    <div style="margin-top: 20px; width: 100%; max-width: 400px;">
        <form id="deleteOrderForm" style="display: flex; flex-direction: column; align-items: center; gap: 20px;">
            <input type="text" id="orderId" placeholder="Sipariş ID'si" style="width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px;" required />
            <button type="button" id="deleteOrderBtn" class="btn" style="background-color: #6a0dad; color: white; padding: 17px; font-size: 16px; border: none; cursor: pointer; border-radius: 4px; width: 100%; transition: background-color 0.3s;">
                Bir Siparişi Sil
            </button>
        </form>
    </div>

    <!-- Ek boşluk -->
    <div style="margin-top: 30px;"></div>
</div>

<script>
    const userId = '@User.FindFirstValue(ClaimTypes.NameIdentifier)';
    console.log("Aktif Kullanıcı ID: ", userId);

    // Hover efektleri
    document.querySelectorAll('.btn').forEach(button => {
        button.addEventListener('mouseenter', () => {
            button.style.backgroundColor = '#5a0c8c';
        });
        button.addEventListener('mouseleave', () => {
            button.style.backgroundColor = '#6a0dad';
        });
    });
        document.getElementById('listOrderBtn').addEventListener('click', function () {
            // GET isteği gönder
            fetch(`/api/Api`, {
                method: 'GET',
            })
            .then(response => {
                if (response.ok) {
                    return response.json();
                } else {
                    throw new Error('Eski siparişler bulunamadı.');
                }
            })
            .then(data => {
                // Modal'ı göster
                const modal = document.getElementById('customModal');
                const appointmentList = document.getElementById('appointmentList');

                // Listeyi doldur
                appointmentList.innerHTML = '';
                data.forEach(appointment => {
                    const listItem = document.createElement('li');
                            listItem.textContent = "Aktif sipariş numarası: " + appointment.appointmentId + " olan siparişiniz tarihi: " + new Date(appointment.appointmentDate).toLocaleString() + "'dir.";
                    appointmentList.appendChild(listItem);
                });

                modal.style.display = 'block';
            })
            .catch(error => {
                console.error('Hata: ', error);
                alert(error.message || 'Bir hata oluştu.');
            });
        });

        // Modal kapatma işlevi
        document.querySelector('.close-btn').addEventListener('click', function () {
            document.getElementById('customModal').style.display = 'none';
        });

        // Modal dışına tıklayınca kapatma
        window.addEventListener('click', function (event) {
            const modal = document.getElementById('customModal');
            if (event.target === modal) {
                modal.style.display = 'none';
            }
        });



    // Sipariş silme işlemi
    document.getElementById('deleteOrderBtn').addEventListener('click', function () {
        const orderId = parseInt(document.getElementById('orderId').value, 10);

        if (isNaN(orderId)) {
            alert('Lütfen geçerli bir Sipariş ID girin.');
            return;
        }

        // DELETE isteği gönder
        fetch(`/api/Api/${orderId}`, {
            method: 'DELETE',
        })
        .then(response => {
            if (response.ok) {
                alert('Sipariş başarıyla silindi.');
            } else {
                alert('Sipariş silme işlemi başarısız oldu.');
            }
        })
        .catch(error => {
            console.error('Hata: ', error);
            alert('Bir hata oluştu.');
        });
    });
</script>
